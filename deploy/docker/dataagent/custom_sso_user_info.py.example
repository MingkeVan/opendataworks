"""自定义 SSO UserInfo 示例（Superset SecurityManager.oauth_user_info 对应物）。

DataAgent 完成 code → token 后调用
``OAUTH_USER_INFO(provider, token_response, oauth_remotes)``。其中
``oauth_remotes[provider]`` 已使用 ``remote_app.api_base_url`` 作为基址并绑定
access token，因此可像 FAB 一样直接 ``.get("userinfo")``。

使用方式：
1. 拷贝本文件为同目录下的 ``custom_sso_user_info.py``（已被 .gitignore 忽略）。
2. 把 Provider 名、相对 UserInfo 路径和 payload 映射改成真实值。
3. 在 ``dataagent_config_docker.py`` 中挂上钩子：

       from custom_sso_user_info import oauth_user_info
       OAUTH_USER_INFO = oauth_user_info

契约：
- 入参 ``provider``：``OAUTH_PROVIDERS[0]["name"]``。
- 入参 ``token_response``：token endpoint 返回的完整 dict。
- 入参 ``oauth_remotes``：provider → 已绑定 token 的同步 HTTP client；相对 URL
  基于 ``remote_app.api_base_url`` 解析，单次 HTTP 请求超时固定为 15 秒。
- 返回 dict 必须含稳定 ``sub``；可直接返回最终 ``display_name``，也兼容
  ``preferred_username`` / ``name`` / ``email``，以及 ``role``（仅 ``admin`` /
  ``user``）。
- 钩子必须同步，DataAgent 会在线程中执行，避免阻塞 FastAPI 事件循环。
- 同一钩子可能被并发调用；不要使用未加锁的共享可变状态，也不要记录
  ``token_response``、access token 或 refresh token。
- 抛异常、超时或返回非 dict：仅该次登录失败，服务继续运行。
"""

def oauth_user_info(provider: str, token_response: dict, oauth_remotes: dict) -> dict:
    """示例：自研 IdP 返回 {"code":0,"data":{"uid":...,"nickname":...}}。"""
    if provider != "SSO":
        raise ValueError(f"unsupported OAuth provider: {provider}")

    # 这里仍会发起一次 HTTP GET；完整 URL 由 remote_app.api_base_url +
    # 相对路径 "userinfo" 组成，Authorization: Bearer 由 DataAgent 自动附加。
    response = oauth_remotes[provider].get("userinfo")
    response.raise_for_status()
    raw = response.json()
    payload = raw.get("data") or raw

    claims = {
        # 唯一标识优先取不可变字段（uid/sub），不要用邮箱/昵称等可变值。
        "sub": str(payload.get("uid") or payload.get("sub") or ""),
        "display_name": str(
            payload.get("nickname") or payload.get("preferred_username") or ""
        ),
    }

    roles = payload.get("roles") or []
    if isinstance(roles, (list, tuple)) and "dataagent-admin" in roles:
        claims["role"] = "admin"

    return claims
