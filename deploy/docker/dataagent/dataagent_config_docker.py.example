"""DataAgent 外置配置用户覆盖示例（Superset superset_config_docker.py 同款机制）。

拷贝本文件为同目录下的 `dataagent_config_docker.py`（已被 .gitignore 忽略，
不会入库），按需修改后重启 dataagent-backend 即生效。本目录在容器内位于
`sys.path` 上，你也可以像 Superset 的 custom_sso_security_manager.py 一样在
同目录放自定义模块并在这里 import（示例见 custom_sso_user_mapper.py.example）。
"""

# ---------------------------------------------------------------------------
# 认证总开关。置 True 前先完成 SECRET_KEY 与至少一种登录方式（LOCAL_ADMINS / OAUTH_PROVIDERS）。
# ---------------------------------------------------------------------------
AUTH_ENABLED = False

# ---------------------------------------------------------------------------
# 会话 JWT 密钥（HS256）。必须替换为随机值，长度不少于 32 字节：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 保留占位值或过短会导致启动失败（fail-closed）。
# ---------------------------------------------------------------------------
SECRET_KEY = "CHANGE-ME-generate-with-secrets.token_urlsafe(32)"

# 会话有效期（秒），默认 8 小时。
SESSION_TTL_SECONDS = 28800

# 会话 Cookie。HttpOnly 由代码硬编码，不可配置。HTTPS 入口置 COOKIE_SECURE = True。
COOKIE_NAME = "da_session"
COOKIE_SECURE = False
COOKIE_SAMESITE = "lax"

# ---------------------------------------------------------------------------
# 本地管理员账号（OAuth 不可用时仍可登录）。password_bcrypt 生成方式：
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# ---------------------------------------------------------------------------
LOCAL_ADMINS = [
    # {"username": "admin", "password_bcrypt": "$2b$12$..."},
]

# ---------------------------------------------------------------------------
# OAuth2 授权码模式（通用 OIDC Provider）。外形与 Superset/FAB 的
# OAUTH_PROVIDERS 一致；本期仅支持单 Provider，配置多项会启动失败。
# remote_app 内三项核心（client_id / authorize_url / access_token_url）
# 齐全才视为已配置；保持下方空列表则登录页只提供本地密码登录。
# 要启用 OAuth，将下方 provider 模板取消注释并填入真实值。
# ---------------------------------------------------------------------------
OAUTH_PROVIDERS = [
    # {
    #     # Provider 键和登录按钮显示名，也作为用户稳定标识前缀。
    #     "name": "SSO",
    #     # Font Awesome 4 class，如 fa-github / fa-google；留空则不显示图标。
    #     "icon": "fa-github",
    #     # token_key 为 FAB/Superset 兼容字段；DataAgent 直接解析 access_token。
    #     "token_key": "access_token",
    #     "remote_app": {
    #         "client_id": "your-client-id",
    #         "client_secret": "your-client-secret",
    #         "authorize_url": "https://sso.example.com/oauth/authorize",
    #         "access_token_url": "https://sso.example.com/oauth/token",
    #         "client_kwargs": {"scope": "openid profile"},
    #         # 必须与 IdP 侧注册的回调一致：
    #         #   https://<dataagent-host>/api/v1/nl2sql/auth/oauth/callback
    #         "redirect_uri": "https://<dataagent-host>/api/v1/nl2sql/auth/oauth/callback",
    #         # DataAgent 传输层固定使用 code / authorization_code，无需配置。
    #     },
    #     # 以下是 DataAgent 扩展字段：按需拉取 userinfo 并映射用户。
    #     "userinfo_url": "https://sso.example.com/oauth/userinfo",
    #     # userinfo 响应里的用户唯一标识与显示名字段（标准平铺 payload 时用）。
    #     "user_id_field": "sub",
    #     "username_field": "preferred_username",
    #     # 登录成功后的回跳路径（仅接受同源应用内路径）。
    #     "post_login_redirect": "/",
    # }
]

# ---------------------------------------------------------------------------
# 非标准 IdP 的 userinfo 映射钩子（可选，Superset custom_sso_security_manager
# 的 oauth_user_info 对应物）。配置后 user_id_field / username_field 不再生效，
# 由钩子完全接管 payload 解析。示例：
#
#   from custom_sso_user_mapper import map_sso_userinfo
#   OAUTH_USERINFO_MAPPER = map_sso_userinfo
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# OAuth 用户提名为管理员：条目为 "<provider_name>:<user_id_field值>"（稳定标识，
# 即 provider:sub）。username 可变、不保证唯一，不参与提权。
# 若 OAUTH_USERINFO_MAPPER 返回了 role 字段，则以钩子返回为准。
# ---------------------------------------------------------------------------
ADMIN_USERS = [
    # "SSO:1024",
]

# ---------------------------------------------------------------------------
# 其他运行时配置覆盖（可选）：键为 dataagent-backend/config.py 中 Settings 的
# 字段名，启动时统一应用；含未知字段会启动失败（fail-closed）。
# ---------------------------------------------------------------------------
DATAAGENT_SETTINGS = {
    # "agent_interactive_timeout_seconds": 420,
    # "task_max_concurrency": 8,
}
