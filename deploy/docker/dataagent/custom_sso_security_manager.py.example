"""自定义 SSO 安全管理器示例（与 Superset 的 custom_sso_security_manager.py 同款写法）。

当 IdP 的 userinfo 响应不是标准 OIDC 平铺结构（嵌套 payload、自定义字段名、
需要按组/角色字段决定管理员）时，继承基类覆写 oauth_user_info，替代 OAUTH 里
user_id_field / username_field 的平铺取值。

使用方式：
1. 拷贝本文件为同目录下的 `custom_sso_security_manager.py`（已被 .gitignore 忽略）。
2. 在 `dataagent_config_docker.py` 中挂上：

       from custom_sso_security_manager import CustomSsoSecurityManager
       CUSTOM_SECURITY_MANAGER = CustomSsoSecurityManager

3. 重启 dataagent-backend。

基类的全部扩展点（未覆写的沿用默认实现）：
- oauth_user_info(provider, userinfo) -> dict
    返回 {"user_id": 必填稳定标识, "username": 可选显示名, "role": 可选 'admin'/'user'}。
    返回 role 则优先生效；运行期抛异常只使该次登录失败，不影响服务。
- resolve_role(provider, user_id, userinfo) -> str
    oauth_user_info 未返回 role 时调用；默认按 ADMIN_USERS（provider:sub）提名。
- verify_local_login(username, password) -> AuthIdentity | None
    默认校验 LOCAL_ADMINS（bcrypt）；对接 LDAP 等其他本地源时覆写。
- on_login(identity) -> None
    登录成功回调（本地与 OAuth 都触发），默认 no-op；可做登录审计、部门同步。
    抛异常只记日志，不阻断登录。
"""
from core.security_manager import DataAgentSecurityManager


class CustomSsoSecurityManager(DataAgentSecurityManager):
    def oauth_user_info(self, provider, userinfo):
        """示例：自研 IdP 返回 {"code":0,"data":{"uid":...,"nickname":...,"roles":[...]}}。"""
        payload = userinfo.get("data") or userinfo

        mapped = {
            # 唯一标识优先取不可变字段（uid/sub），不要用邮箱/昵称等可变值。
            "user_id": payload.get("uid") or payload.get("sub") or "",
            "username": payload.get("nickname") or payload.get("preferred_username") or "",
        }

        # 可选：按 IdP 的组/角色字段直接授予管理员（不返回 role 则由 ADMIN_USERS 决定）。
        roles = payload.get("roles") or []
        if isinstance(roles, (list, tuple)) and "dataagent-admin" in roles:
            mapped["role"] = "admin"

        return mapped
