"""自定义 SSO userinfo 映射示例（Superset custom_sso_security_manager 对应物）。

当 IdP 的 userinfo 响应不是标准 OIDC 平铺结构（嵌套 payload、自定义字段名、
需要按组/角色字段决定管理员）时，用本钩子完全接管解析，替代 OAUTH_PROVIDERS 里的
user_id_field / username_field 平铺取值。

使用方式：
1. 拷贝本文件为同目录下的 `custom_sso_user_mapper.py`（已被 .gitignore 忽略）。
2. 在 `dataagent_config_docker.py` 中挂上钩子：

       from custom_sso_user_mapper import map_sso_userinfo
       OAUTH_USERINFO_MAPPER = map_sso_userinfo

3. 重启 dataagent-backend。

契约：
- 入参：userinfo 端点返回的 dict（原样透传，未做任何字段假设）。
- 返回 dict：
    - "user_id"（必填）：用户稳定唯一标识（如 sub）。会被拼成
      "<provider_name>:<user_id>" 作为会话归属与 ADMIN_USERS 提名键。
    - "username"（可选）：显示名，缺省用 user_id。
    - "role"（可选）："admin" / "user"。返回则优先生效；不返回（或返回其他值）
      则回落到 ADMIN_USERS（provider:sub）提名逻辑。
- 钩子抛异常或返回非 dict：该次登录失败（跳回登录页并带 error），服务不受影响。
"""


def map_sso_userinfo(userinfo: dict) -> dict:
    """示例：自研 IdP 返回 {"code":0,"data":{"uid":...,"nickname":...,"roles":[...]}}。"""
    payload = userinfo.get("data") or userinfo

    mapped = {
        # 唯一标识优先取不可变字段（uid/sub），不要用邮箱/昵称等可变值。
        "user_id": payload.get("uid") or payload.get("sub") or "",
        "username": payload.get("nickname") or payload.get("preferred_username") or "",
    }

    # 可选：按 IdP 的组/角色字段直接授予管理员（不返回 role 则由 ADMIN_USERS 决定）。
    roles = payload.get("roles") or []
    if isinstance(roles, (list, tuple)) and "dataagent-admin" in roles:
        mapped["role"] = "admin"

    return mapped
