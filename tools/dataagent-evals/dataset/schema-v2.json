{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendataworks.local/schemas/dataagent-evaluation-v2.json",
  "title": "DataAgent Evaluation Case V2",
  "type": "object",
  "required": [
    "schema_version", "case_id", "category", "case_type", "suite_tags",
    "expected_semantics", "expected_time", "expected_tools", "expected_sql",
    "expected_result", "expected_answer", "limits", "scoring", "veto_rules"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "case_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "case_type": {"enum": ["definition", "query", "analysis", "negative", "multiturn"]},
    "suite_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "question": {"type": "string"},
    "turns": {"type": "array", "minItems": 1},
    "expected_semantics": {"type": "object"},
    "expected_time": {"type": "object"},
    "expected_tools": {"type": "object"},
    "expected_sql": {"type": "object"},
    "expected_result": {
      "type": "object",
      "properties": {
        "allow_empty": {"type": "boolean"},
        "required_columns": {"type": "array", "items": {"type": "string"}},
        "answer_result_fields": {"type": "array", "items": {"type": "string"}},
        "reference_query": {
          "type": "object",
          "required": ["sql"],
          "properties": {
            "sql": {"type": "string", "minLength": 1},
            "database": {"type": "string"},
            "engine": {"type": "string"},
            "limit": {"type": "integer", "minimum": 1},
            "comparison_mode": {"enum": ["exact_rows", "unordered_values", "scalar"]},
            "numeric_tolerance": {"type": "number", "minimum": 0}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "expected_answer": {"type": "object"},
    "limits": {"type": "object"},
    "scoring": {
      "type": "object",
      "required": ["intent", "ontology_entity", "relation_scope", "sql_or_tool_call", "result_consistency", "reasoning", "answer_quality", "total_score"]
    },
    "veto_rules": {"type": "array"},
    "judge_guidance": {"type": "string"}
  },
  "anyOf": [
    {"required": ["question"]},
    {"required": ["turns"]}
  ],
  "additionalProperties": true
}
